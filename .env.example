# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "llama", "groq", "openrouter", "ollama", hoặc "mock"
LLM_PROVIDER=llama

# Llama API Key (Groq / OpenRouter / Together — dán key thật vào đây)
LLAMA_API_KEY=your_llama_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (không dùng khi LLM_PROVIDER=llama)
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.5-flash

# OpenAI (không dùng khi LLM_PROVIDER=llama)
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#             LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Ollama local: OPENAI_BASE_URL=http://localhost:11434/v1
#               LLAMA_API_KEY=ollama
#               LLM_MODEL=llama3.1

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# Redis short-term memory (10 prompt cũ / máy)
REDIS_URL=redis://localhost:6379/0
MEMORY_LIMIT=10
